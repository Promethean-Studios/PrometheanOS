[Unit]
Description=Promethean Ollama local inference service
Documentation=https://ollama.com
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/bin/ollama

[Service]
Type=simple
User=promethean
Group=promethean
ExecStart=/usr/bin/env ollama serve
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_ORIGINS=http://127.0.0.1:8765
Environment=OLLAMA_KEEP_ALIVE=24h
Environment=OLLAMA_MODELS=/data/models/ollama
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/data/models /var/log

[Install]
WantedBy=multi-user.target
